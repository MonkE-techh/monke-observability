# For local runs: copy to admin/backend/.env (git-ignored, never commit it) and start with
#   uv run --env-file .env uvicorn monke_admin.main:create_app --factory --port 8000
# On Render these are set in the service's Environment settings instead. Names only here.
APP_ENV=development
POSTHOG_APP_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# at least 32 random characters
SESSION_SECRET=
# comma-separated Google accounts allowed in
ADMIN_EMAILS=
# optional: also require this Google Workspace domain
GOOGLE_WORKSPACE_DOMAIN=
PUBLIC_URL=http://127.0.0.1:8000
# local only: skip Google sign-in (refused when APP_ENV=production)
AUTH_DISABLED=false
